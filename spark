/*
 * --------------------------------------------------------------------
 * CodeIgniter command-line tools (Checka)
 * --------------------------------------------------------------------
 * Usage:  php spark  (lists commands)
 */

// Refuse to run when called from php-cgi
if (str_starts_with(PHP_SAPI, 'cgi')) {
    exit("The spark CLI tool is not supported when running php-cgi. It can only be invoked from the command line using a version of PHP with the CLI SAPI.\n");
}

// We want errors to be shown when using it from the CLI.
error_reporting(-1);
ini_set('display_errors', '1');

// Path to the front controller
define('FCPATH', __DIR__ . DIRECTORY_SEPARATOR . 'public' . DIRECTORY_SEPARATOR);

// Load our paths config file
require realpath('app/Config/Paths.php') ?: 'app/Config/Paths.php';
$paths = new Config\Paths();

// Multi-tenant: CHECKA_TENANT=<slug> php spark ...  runs a command for one workspace.
require __DIR__ . '/app/Tenancy/Tenant.php';
App\Tenancy\Tenant::bootstrap($paths);

// Location of the framework bootstrap file.
require rtrim($paths->systemDirectory, '\\/ ') . DIRECTORY_SEPARATOR . 'Boot.php';

exit(CodeIgniter\Boot::bootSpark($paths));
